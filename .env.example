# Shell examples only; the app does not auto-load this file.
ENABLE_TEST_SITE=false
SCRAPE_ENABLED=false
# Keep false on Render Free. Opt in only for a local, continuously running timer.
SCRAPE_IN_PROCESS=false
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_OUTPUT_TOKENS=4096
# Set OLLAMA_API_KEY in your server environment or mount a private secret file.
# OLLAMA_API_KEY_FILE=/absolute/path/to/ollama-api-key
OCR_MAX_PIXELS=4000000
SCRAPE_TIMEZONE=Asia/Seoul
SCRAPE_HOUR=6
SCRAPE_MINUTE=0
# Required for manual scraping and saved results, even with scheduling disabled.
# Firebase console project ID; create a Standard edition Firestore database.
# FIREBASE_PROJECT_ID=your-project-id
FIRESTORE_DATABASE=(default)
# ADC service-account JSON path; keep the file outside the repo or in secrets/.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Local emulator ONLY; never set on Render/production.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# SCRAPE_TRIGGER_TOKEN=replace-with-a-long-random-secret
SCRAPE_DAILY_MAX_ARTICLES=5
SCRAPE_RETRY_ATTEMPTS=3
SCRAPE_RETRY_BASE_SECONDS=2
SCRAPE_REQUEST_GAP_SECONDS=2
